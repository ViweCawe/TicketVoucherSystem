@page
@model TicketVoucherSystemApp.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Dashboard";
    var currency = System.Globalization.CultureInfo.GetCultureInfo("en-ZA");
}

<section class="dashboard-masthead">
    <div><p class="eyebrow">Live command view</p><h1>Voucher performance</h1><p>Allocation, redemption value, and outlet movement in one view.</p></div>
    <div class="masthead-date"><span>REPORTING WINDOW</span><strong>Last 30 days</strong></div>
</section>

<section class="scoreline">
    <div><span>ISSUED</span><strong>@Model.Summary.TotalIssued</strong><small>@Model.Summary.IssuedValue.ToString("C0", currency) value</small></div>
    <div><span>REDEEMED</span><strong>@Model.Summary.TotalRedeemed</strong><small>@Model.Summary.RedeemedValue.ToString("C0", currency) value</small></div>
    <div><span>OUTSTANDING</span><strong>@Model.Summary.TotalOutstanding</strong><small>@Model.Summary.OutstandingValue.ToString("C0", currency) exposure</small></div>
    <div><span>CONVERSION</span><strong>@Model.Summary.RedemptionRate.ToString("0.0")%</strong><small>@Model.Summary.RedeemedToday today</small></div>
</section>

<div class="insight-canvas">
    <section class="line-visual">
        <div class="visual-heading"><div><p class="eyebrow">Value curve</p><h2>Daily redemption value</h2></div><span>7 DAYS</span></div>
        <svg viewBox="0 0 700 220" role="img" aria-label="Seven day redeemed voucher value line chart">
            <line x1="20" y1="190" x2="680" y2="190"></line>
            <line x1="20" y1="112" x2="680" y2="112"></line>
            <line x1="20" y1="35" x2="680" y2="35"></line>
            @if (!string.IsNullOrEmpty(Model.LinePoints))
            {
                <polyline points="@Model.LinePoints"></polyline>
            }
        </svg>
        <div class="axis-labels">@foreach (var day in Model.Trend) { <span>@day.ReportDate.ToString("ddd")</span> }</div>
    </section>

    <section class="outlet-visual">
        <div class="visual-heading"><div><p class="eyebrow">Redemption map</p><h2>Value by outlet</h2></div></div>
        <div class="donut-wrap">
            <div class="donut" style="@Model.DonutStyle"><span><strong>@Model.Summary.TotalRedeemed</strong><small>redeemed</small></span></div>
            <div class="donut-legend">
                @for (var index = 0; index < Model.Outlets.Count; index++)
                {
                    var outlet = Model.Outlets[index];
                    <div><i style="background:@Model.Colors[index % Model.Colors.Count]"></i><span><strong>@outlet.OutletName</strong><small>@outlet.SharePercent.ToString("0.0")% · @outlet.RedeemedValue.ToString("C0", currency)</small></span></div>
                }
                @if (Model.Outlets.Count == 0) { <p class="empty-copy">No outlet redemptions in this period.</p> }
            </div>
        </div>
    </section>

    <section class="activity-ledger">
        <div class="visual-heading"><div><p class="eyebrow">Ledger</p><h2>Recent vouchers</h2></div></div>
        @foreach (var voucher in Model.RecentVouchers)
        {
            <div class="ledger-row">
                <time>@voucher.IssuedUtc.ToLocalTime().ToString("dd MMM HH:mm")</time>
                <span><strong>@voucher.Code</strong><small>@voucher.PackageName</small></span>
                <span class="status @voucher.Status.ToLowerInvariant()">@voucher.Status</span>
                <span>@(voucher.RedeemedAt ?? "-")</span>
                @if (User.IsInRole("Admin")) { <a asp-page="/Admin/Vouchers/Details" asp-route-id="@voucher.Id">Open</a> }
            </div>
        }
    </section>
</div>
