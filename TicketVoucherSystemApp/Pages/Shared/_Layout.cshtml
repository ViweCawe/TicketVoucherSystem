<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Ticket Voucher System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TicketVoucherSystemApp.styles.css" asp-append-version="true" />
</head>
<body>
    <aside class="sidebar">
        <a class="brand" asp-page="/Operations/Issue">
            <span class="brand-mark">TV</span>
            <span>Ticket Vouchers</span>
        </a>
        <nav aria-label="Main navigation">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-page="/Operations/Issue">Issue vouchers</a>
                <a asp-page="/Operations/Redeem" asp-route-department="Retail">Retail redeem</a>
                <a asp-page="/Operations/Redeem" asp-route-department="FoodAndBeverage">F&amp;B redeem</a>
                <a asp-page="/Operations/Import">Import pairs</a>
                @if (User.IsInRole("Admin"))
                {
                    <span class="nav-label">Administration</span>
                    <a asp-page="/Admin/Vouchers/Index">Voucher register</a>
                    <a asp-page="/Admin/Packages/Index">Packages</a>
                }
            }
            else
            {
                <a asp-area="Identity" asp-page="/Account/Login">Sign in</a>
                <a asp-area="Identity" asp-page="/Account/Register">Create account</a>
            }
        </nav>
        <div class="sidebar-user">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-area="Identity" asp-page="/Account/Manage/Index">@User.Identity.Name</a>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
                    <button class="link-button" type="submit">Sign out</button>
                </form>
            }
            else
            {
                <span>Secure voucher operations</span>
            }
        </div>
    </aside>
    <main class="main">
        <header class="topbar">
            <span>TABLE MOUNTAIN / VOUCHER OPERATIONS</span>
        </header>
        <div class="content">
            @RenderBody()
        </div>
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
