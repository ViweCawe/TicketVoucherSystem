@page
@model TicketVoucherSystemApp.Pages.Admin.Vouchers.IndexModel
@{
    ViewData["Title"] = "Voucher register";
}

<div class="page-heading">
    <div>
        <p class="eyebrow">Administration</p>
        <h1>Voucher register</h1>
        <p>Search every voucher and open its full activity history.</p>
    </div>
</div>

<div class="metric-strip">
    <div><span>Issued</span><strong>@Model.Dashboard.IssuedCount</strong></div>
    <div><span>Redeemed</span><strong>@Model.Dashboard.RedeemedCount</strong></div>
    <div><span>Outstanding</span><strong>@Model.Dashboard.OutstandingValue.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-ZA"))</strong></div>
    <div><span>Redeemed today</span><strong>@Model.Dashboard.RedeemedValueToday.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-ZA"))</strong></div>
</div>

<form method="get" class="filter-bar">
    <input name="search" value="@Model.Search" placeholder="Search barcode or package" />
    <select name="status">
        <option value="">All statuses</option>
        @foreach (var status in new[] { "Issued", "Redeemed", "Expired", "Cancelled" })
        {
            <option value="@status" selected="@(Model.Status == status ? "selected" : null)">@status</option>
        }
    </select>
    <button class="button primary" type="submit">Search</button>
</form>

<div class="table-wrap">
    <table>
        <thead>
            <tr><th>Voucher</th><th>Package</th><th>Value</th><th>Issued</th><th>Status</th><th>Redeemed</th><th>Details</th></tr>
        </thead>
        <tbody>
            @foreach (var voucher in Model.Vouchers)
            {
                <tr>
                    <td>
                        <a class="voucher-code-link" asp-page="Details" asp-route-id="@voucher.Id"><strong>@voucher.Code</strong></a>
                        <small>@voucher.DepartmentType</small>
                    </td>
                    <td>@voucher.PackageName</td>
                    <td>@voucher.Amount.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-ZA"))</td>
                    <td>@voucher.IssuedUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                    <td><span class="status @voucher.Status.ToLowerInvariant()">@voucher.Status</span></td>
                    <td>@(voucher.RedeemedUtc?.ToLocalTime().ToString("dd MMM yyyy HH:mm") ?? "-")</td>
                    <td><a class="text-link" asp-page="Details" asp-route-id="@voucher.Id">Open</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>
