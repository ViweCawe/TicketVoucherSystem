@page
@model TicketVoucherSystemApp.Pages.Admin.WebTickets.IndexModel
@{
    ViewData["Title"] = "Webtickets lookup";
}

<header class="ticket-issue-heading">
    <p class="eyebrow">Webtickets verification</p>
    <h1>Look up a purchased transaction.</h1>
    <p>Scan any ticket barcode to load every ticket in its Webtickets transaction, then select the tickets that should receive a voucher package.</p>
</header>

<div asp-validation-summary="ModelOnly" class="alert error"></div>

<form method="post" asp-page-handler="Lookup" class="ticket-issue-console">
    <section class="ticket-scan-step">
        <span class="step-number">01</span>
        <div>
            <label asp-for="Barcode">Webtickets barcode</label>
            <div class="ticket-scan-input">
                <span>SCAN</span>
                <input asp-for="Barcode" autofocus autocomplete="off" placeholder="SCNVQZC594L" />
            </div>
            <span asp-validation-for="Barcode" class="validation"></span>
        </div>
    </section>
    <footer>
        <span>The barcode identifies its containing Webtickets transaction.</span>
        <button class="button primary" type="submit">Look up transaction</button>
    </footer>
</form>

@if (Model.Lookup is not null)
{
    var purchaserName = string.IsNullOrWhiteSpace(Model.Lookup.Basket.CustomerName)
        ? "Not supplied"
        : Model.Lookup.Basket.CustomerName;
    var purchaserEmail = string.IsNullOrWhiteSpace(Model.Lookup.Basket.CustomerEmail)
        ? "Not supplied"
        : Model.Lookup.Basket.CustomerEmail;

    <section class="detail-summary" style="margin-top: 22px;">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Authorized transaction found</p>
                <h2>Transaction @Model.Lookup.Transaction.TransactionId</h2>
            </div>
            <span class="status">@Model.Lookup.Transaction.Tickets.Count tickets</span>
        </div>

        <dl>
            <div><dt>Reference</dt><dd>@Model.Lookup.Basket.Reference</dd></div>
            <div><dt>Purchaser name</dt><dd>@purchaserName</dd></div>
            <div><dt>Email</dt><dd>@purchaserEmail</dd></div>
            <div><dt>Transaction total</dt><dd>@($"R {Model.Lookup.Transaction.TransactionAmount:N2}")</dd></div>
        </dl>

        <form method="post" asp-page-handler="Assign" class="stack-form" style="margin-top: 20px;">
            <input asp-for="Barcode" type="hidden" />

            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>
                                <input id="select-all-tickets" type="checkbox" aria-label="Select all authorized tickets" />
                            </th>
                            <th>Type</th>
                            <th>Ticket holder</th>
                            <th>Email</th>
                            <th>Barcode</th>
                            <th>Time slot</th>
                            <th>Scanned</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var index = 0; index < Model.Lookup.Transaction.Tickets.Count; index++)
                        {
                            var ticket = Model.Lookup.Transaction.Tickets[index];
                            var ticketHolder = string.IsNullOrWhiteSpace(ticket.TicketHolder)
                                ? purchaserName
                                : ticket.TicketHolder;
                            var email = string.IsNullOrWhiteSpace(ticket.Email)
                                ? purchaserEmail
                                : ticket.Email;
                            var isSelected = Model.SelectedBarcodes.Contains(
                                ticket.Barcode, StringComparer.OrdinalIgnoreCase);

                            <tr>
                                <td>
                                    <input class="ticket-selector"
                                           type="checkbox"
                                           name="SelectedBarcodes"
                                           value="@ticket.Barcode"
                                           checked="@(isSelected ? "checked" : null)"
                                           disabled="@(!ticket.Authorized ? "disabled" : null)"
                                           aria-label="Select ticket @ticket.Barcode" />
                                </td>
                                <td>@ticket.TicketType</td>
                                <td>@ticketHolder</td>
                                <td>@email</td>
                                <td>
                                    <a class="row-action ticket-detail-link"
                                       href="#ticket-detail-@index"
                                       data-ticket-detail
                                       aria-controls="ticket-detail-@index"
                                       aria-expanded="false">@ticket.Barcode</a>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(ticket.Performance) ? "Not supplied" : ticket.Performance)</td>
                                <td>@(ticket.Validated ? "Yes" : "No")</td>
                            </tr>
                            <tr id="ticket-detail-@index" class="ticket-detail-row" hidden>
                                <td colspan="7">
                                    <div class="ticket-detail-panel">
                                        <header>
                                            <strong>@ticket.TicketType</strong>
                                            <span class="status">@(ticket.Authorized ? "Ready to assign" : "Not authorized")</span>
                                        </header>
                                        <dl>
                                            <div><dt>Barcode</dt><dd>@ticket.Barcode</dd></div>
                                            <div><dt>Reference</dt><dd>@Model.Lookup.Basket.Reference</dd></div>
                                            <div><dt>Ticket price</dt><dd>@($"R {ticket.TicketPrice:N2}")</dd></div>
                                            <div><dt>Performance</dt><dd>@(string.IsNullOrWhiteSpace(ticket.Performance) ? "Not supplied" : ticket.Performance)</dd></div>
                                            <div><dt>Entry status</dt><dd>@(ticket.Validated ? "Validated" : "Not validated")</dd></div>
                                        </dl>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <span asp-validation-for="SelectedBarcodes" class="validation"></span>

            <label class="field">
                <span>Voucher package</span>
                <select asp-for="TicketPackageId">
                    <option value="">Choose the package to attach</option>
                    @foreach (var package in Model.Packages)
                    {
                        <option value="@package.Id">@package.Name - @package.BenefitSummary</option>
                    }
                </select>
                <span asp-validation-for="TicketPackageId" class="validation"></span>
            </label>

            <div class="button-row">
                <button class="button primary" type="submit">Verify selection and assign package</button>
            </div>
        </form>
    </section>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const selectAllTickets = document.getElementById('select-all-tickets');
        const ticketSelectors = Array.from(document.querySelectorAll('.ticket-selector:not(:disabled)'));

        if (selectAllTickets) {
            const updateSelectAll = () => {
                const selectedCount = ticketSelectors.filter(input => input.checked).length;
                selectAllTickets.checked = ticketSelectors.length > 0 && selectedCount === ticketSelectors.length;
                selectAllTickets.indeterminate = selectedCount > 0 && selectedCount < ticketSelectors.length;
            };

            selectAllTickets.addEventListener('change', () => {
                ticketSelectors.forEach(input => input.checked = selectAllTickets.checked);
                updateSelectAll();
            });
            ticketSelectors.forEach(input => input.addEventListener('change', updateSelectAll));
            updateSelectAll();
        }

        document.querySelectorAll('[data-ticket-detail]').forEach(link => {
            link.addEventListener('click', event => {
                event.preventDefault();
                const detailRow = document.getElementById(link.getAttribute('aria-controls'));
                const willOpen = detailRow.hidden;

                detailRow.hidden = !willOpen;
                link.setAttribute('aria-expanded', willOpen.toString());

                if (willOpen)
                    history.replaceState(null, '', link.getAttribute('href'));
            });
        });
    </script>
}
