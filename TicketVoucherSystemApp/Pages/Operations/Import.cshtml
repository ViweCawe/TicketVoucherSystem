@page
@model TicketVoucherSystemApp.Pages.Operations.ImportModel
@{
    ViewData["Title"] = "Barcode intake";
}

<header class="command-heading">
    <div>
        <span class="command-index">01</span>
        <p class="eyebrow">Inventory intake</p>
        <h1>Load physical ticket barcodes</h1>
        <p>Every imported ticket becomes one available Retail barcode and one available F&amp;B barcode.</p>
    </div>
    <a class="button secondary" asp-page="/Operations/Issue">Go to allocation</a>
</header>

<section class="stock-ribbon" aria-label="Barcode stock">
    <div><span>Available Retail</span><strong>@Model.Stock.AvailableRetail</strong></div>
    <div><span>Available F&amp;B</span><strong>@Model.Stock.AvailableFoodAndBeverage</strong></div>
    <div><span>Total available</span><strong>@Model.Stock.TotalAvailable</strong></div>
    <div><span>Already allocated</span><strong>@(Model.Stock.AssignedRetail + Model.Stock.AssignedFoodAndBeverage)</strong></div>
</section>

<div class="intake-layout">
    <form method="post" class="intake-console">
        <div class="console-bar"><span>BARCODE INPUT</span><span>10 DIGITS EACH</span></div>
        <div asp-validation-summary="ModelOnly" class="alert error"></div>
        <label class="field barcode-field">
            <span>Ticket barcode list</span>
            <textarea asp-for="BarcodeList" rows="15" placeholder="1234567890&#10;0987654321" autofocus></textarea>
            <small>Paste one code per line or separate codes with commas. Existing codes are safely skipped.</small>
            <span asp-validation-for="BarcodeList" class="validation"></span>
        </label>
        <div class="console-actions">
            <span>Importing does not issue vouchers. It only makes barcode stock available.</span>
            <button class="button primary" type="submit">Import barcode stock</button>
        </div>
    </form>

    <aside class="process-rail">
        <p class="eyebrow">Controlled flow</p>
        <ol>
            <li class="active"><span>1</span><div><strong>Import</strong><small>Register existing ticket codes</small></div></li>
            <li><span>2</span><div><strong>Allocate</strong><small>Attach an available code to a package</small></div></li>
            <li><span>3</span><div><strong>Redeem</strong><small>Scan at a configured outlet</small></div></li>
        </ol>
        @if (Model.Result is not null)
        {
            <div class="intake-result">
                <strong>@Model.Result.ImportedCount imported</strong>
                <span>@Model.Result.DuplicateCount duplicates skipped</span>
                <small>@Model.Result.AvailableCount barcode entries now available</small>
            </div>
        }
    </aside>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
