@page
@model TicketVoucherSystemApp.Pages.Operations.IssueModel
@{
    ViewData["Title"] = "Attach voucher package";
}

<header class="ticket-issue-heading">
    <p class="eyebrow">Ticket voucher issue</p>
    <h1>Scan the ticket.<br />Attach the benefits.</h1>
    <p>The ticket already owns the barcode. This system only adds the purchased voucher package.</p>
</header>

<form method="post" class="ticket-issue-console">
    <div asp-validation-summary="ModelOnly" class="alert error"></div>
    <section class="ticket-scan-step">
        <span class="step-number">01</span>
        <div>
            <label for="TicketNumber">Existing ticket barcode</label>
            <div class="ticket-scan-input"><span>SCAN</span><input asp-for="TicketNumber" placeholder="Scan or enter ticket number" autofocus autocomplete="off" /></div>
            <span asp-validation-for="TicketNumber" class="validation"></span>
        </div>
    </section>

    <section class="ticket-package-step">
        <span class="step-number">02</span>
        <div>
            <h2>Purchased package</h2>
            <div class="ticket-package-list">
                @foreach (var package in Model.Packages)
                {
                    <label>
                        <input asp-for="TicketPackageId" type="radio" value="@package.Id" />
                        <span><strong>@package.Name</strong><small>@package.Description</small><b>@package.BenefitSummary</b></span>
                        <em>@package.BenefitCount benefits</em>
                    </label>
                }
            </div>
            <span asp-validation-for="TicketPackageId" class="validation"></span>
        </div>
    </section>

    <footer>
        <span>The next screen is a clean printable ticket page with the same barcode.</span>
        <button class="button primary" type="submit">Attach package and continue</button>
    </footer>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
