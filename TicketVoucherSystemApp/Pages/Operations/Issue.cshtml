@page
@model TicketVoucherSystemApp.Pages.Operations.IssueModel
@{
    ViewData["Title"] = "Issue ticket package";
}

<header class="group-issue-heading">
    <div>
        <p class="eyebrow">Manual ticket issue</p>
        <h1>One package.<br />One or many tickets.</h1>
    </div>
    <p>Scan the existing ticket barcodes and attach the same purchased package to the complete group.</p>
</header>

<form method="post" class="group-issue-console">
    <div asp-validation-summary="ModelOnly" class="alert error"></div>

    <label class="group-field">
        <span>Ticket package</span>
        <select asp-for="TicketPackageId">
            <option value="">Choose the purchased package</option>
            @foreach (var package in Model.Packages)
            {
                <option value="@package.Id">@package.Name - @package.BenefitSummary</option>
            }
        </select>
        <small>The selected package will be attached to every barcode below.</small>
        <span asp-validation-for="TicketPackageId" class="validation"></span>
    </label>

    <label class="group-field barcode-list-field">
        <span>Existing ticket barcodes</span>
        <textarea asp-for="TicketNumbers" rows="12" placeholder="Scan each ticket and press Enter" autofocus autocomplete="off"></textarea>
        <small><strong id="ticket-count">0 tickets</strong><span>Maximum 100 per issue</span></small>
        <span asp-validation-for="TicketNumbers" class="validation"></span>
    </label>

    <footer>
        <span>All barcodes are validated before anything is issued.</span>
        <button class="button primary" type="submit">Issue package to tickets</button>
    </footer>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const ticketInput = document.getElementById('TicketNumbers');
        const ticketCount = document.getElementById('ticket-count');
        const updateCount = () => {
            const count = ticketInput.value.split(/[\s,;]+/).filter(Boolean).length;
            ticketCount.textContent = `${count} ${count === 1 ? 'ticket' : 'tickets'}`;
        };
        ticketInput.addEventListener('input', updateCount);
        updateCount();
    </script>
}
