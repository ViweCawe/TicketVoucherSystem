@page
@model TicketVoucherSystemApp.Pages.Operations.RedeemModel
@{
    var isFood = Model.Department == VoucherDepartments.FoodAndBeverage;
    ViewData["Title"] = isFood ? "F&B redemption" : "Retail redemption";
}

<div class="redemption-station @(isFood ? "food-station" : "retail-station")">
    <header>
        <div><p class="eyebrow">Live redemption</p><h1>@(isFood ? "F&B" : "Retail") scan station</h1></div>
        <span class="station-status"><i></i> Ready for scan</span>
    </header>

    <form method="post" class="station-console">
        <input asp-for="Department" type="hidden" />
        <div class="outlet-selector">
            <label for="OutletId">Redeeming outlet</label>
            <select asp-for="OutletId">
                <option value="">Select the outlet once</option>
                @foreach (var outlet in Model.Outlets)
                {
                    <option value="@outlet.Id">@outlet.Name</option>
                }
            </select>
            <small>The selected outlet stays selected while you process the next tickets.</small>
        </div>
        <div class="scan-console">
            <span class="scan-prompt">SCAN</span>
            <input asp-for="Code" placeholder="Scan or enter 10-digit barcode" autofocus autocomplete="off" />
            <button type="submit">Redeem voucher</button>
        </div>
        <div asp-validation-summary="ModelOnly" class="station-message error"></div>
        @if (Model.RedeemedVoucher is not null)
        {
            <div class="station-message success">
                <span>REDEEMED</span>
                <strong>@Model.RedeemedVoucher.Code</strong>
                <span>@Model.RedeemedVoucher.PackageName at @Model.RedeemedVoucher.RedeemedAt</span>
            </div>
        }
    </form>

    <footer><span>OUTLET-CONTROLLED</span><span>TYPO-PROTECTED</span><span>AUDIT-READY</span></footer>
</div>
