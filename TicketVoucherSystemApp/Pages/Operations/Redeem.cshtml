@page
@model TicketVoucherSystemApp.Pages.Operations.RedeemModel
@{
    var isFood = Model.Department == VoucherDepartments.FoodAndBeverage;
    ViewData["Title"] = isFood ? "F&B redeem" : "Retail redeem";
}

<div class="redeem-shell">
    <p class="eyebrow">@(isFood ? "Food & beverage" : "Retail") / redemption</p>
    <h1>Scan @(isFood ? "F&B" : "retail") voucher<br />to redeem.</h1>
    <p>Only matching, active vouchers can be redeemed on this page.</p>
    <form method="post" class="redeem-form">
        <input asp-for="Department" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="validation"></div>
        <label class="field">
            <span>Redemption location</span>
            <input asp-for="Location" placeholder="e.g. Upper Cable Station" autocomplete="organization" />
        </label>
        <label class="scan-field">
            <span class="sr-only">Voucher barcode</span>
            <input asp-for="Code" placeholder="Scan or enter voucher barcode" autofocus autocomplete="off" />
            <button type="submit">Redeem</button>
        </label>
    </form>
    @if (Model.RedeemedVoucher is not null)
    {
        <div class="success-message">
            <strong>Voucher redeemed</strong>
            <span>@Model.RedeemedVoucher.PackageName · @Model.RedeemedVoucher.Amount.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-ZA"))</span>
        </div>
    }
</div>
