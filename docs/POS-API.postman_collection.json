{
  "info": {
    "name": "Public voucher API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:7240"
    }
  ],
  "item": [
    {
      "name": "lookup",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/pos/v1/vouchers/lookup",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"voucherCode\": \"1605729254\", \"departmentType\": \"FoodAndBeverage\"}"
        }
      }
    },
    {
      "name": "redeem",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/pos/v1/vouchers/redeem",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"voucherCode\": \"1605729254\", \"departmentType\": \"FoodAndBeverage\"}"
        }
      }
    }
  ]
}