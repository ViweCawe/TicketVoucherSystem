# Set posBasicCredentials privately to Base64(username:password); never commit a live value.
@posBasicCredentials = REPLACE_LOCALLY
@baseUrl = https://localhost:7240

### lookup
POST {{baseUrl}}/api/pos/v1/vouchers/lookup
Authorization: Basic {{posBasicCredentials}}
Content-Type: application/json

{
  "voucherCode": "1605729254",
  "departmentType": "FoodAndBeverage"
}

### redeem
POST {{baseUrl}}/api/pos/v1/vouchers/redeem
Authorization: Basic {{posBasicCredentials}}
Content-Type: application/json

{
  "voucherCode": "1605729254",
  "departmentType": "FoodAndBeverage"
}
